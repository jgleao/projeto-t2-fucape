# Copie para .env se quiser mudar algum parametro (opcional - ha valores padrao).
AIRFLOW_UID=50000

# Jogos coletados (app_id da Steam, separados por virgula). Vazio = lista padrao do projeto.
STEAM_APP_IDS=

# Idioma das reviews (codigo da API da Steam)
STEAM_IDIOMA=brazilian

# Paginas de 100 reviews por jogo na primeira carga e nas cargas incrementais
STEAM_MAX_PAGINAS_INICIAL=25
STEAM_MAX_PAGINAS_INCREMENTAL=20
